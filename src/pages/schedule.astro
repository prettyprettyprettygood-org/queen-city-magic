---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { CalendarDays, CalendarHeart } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Divider from "@/components/Divider.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import EventCountdown from "@/components/EventCountdown.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import ScheduleTimeline from "@/components/ScheduleTimeline.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { festivalServices, schedule2025 } from "@/data/schedule2025";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Schedule — Magical Event">
  <PageHeader width="wide">Schedule</PageHeader>

  <Section width="wide">
    <Card featured center>
      <CalendarHeart slot="icon" size={22} aria-hidden="true" />
      <h2 slot="title">Schedule</h2>
      <p class="schedule-dates">November 26, 2026</p>
      <EventCountdown />
      <p>
        Lorem ipsum dolor sit amet — we're still finalizing this year's lineup, check back
        closer to the event for the full schedule.
      </p>
    </Card>

    <Divider />

    <Card>
      <CalendarDays slot="icon" size={22} aria-hidden="true" />
      <h2 slot="title">Sample Schedule</h2>
      <p class="schedule-preview-note">
        A preview of what a day at Magical Event might look like.
      </p>

      <div class="schedule-body">
        <ScheduleTimeline days={schedule2025} />

        <div class="festival-services">
          <h3 class="festival-services__heading">Festival Services</h3>
          <p class="festival-services__subhead">Available Saturday & Sunday</p>
          <ul class="festival-services__list">
            {
              festivalServices.map((service) => (
                <li>
                  <span class="festival-services__name">{service.name}</span>
                  {" — "}
                  {service.detail}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Card>
  </Section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    font-weight: 400;
    color: var(--color-surface-gold);
  }

  .schedule-preview-note {
    margin: 0;
    font-style: italic;
    opacity: 0.85;
    line-height: 1.6;
  }

  .schedule-dates {
    margin: -0.6rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    letter-spacing: 0.02em;
  }

  .schedule-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .festival-services {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-surface-border);
  }

  .festival-services__heading {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-surface-gold);
    letter-spacing: 0.02em;
    margin: 0 0 0.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--color-surface-gold);
  }

  .festival-services__subhead {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .festival-services__list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .festival-services__name {
    font-weight: 600;
  }
</style>
