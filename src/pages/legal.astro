---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
import attribution from "@/content/attribution.md?raw";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const attributionHtml = attribution
  .trim()
  .split(/\n\s*\n/)
  .map((entry) => `<p>${entry}</p>`)
  .join("");
---

<BaseLayout title="Legal & Attributions — Magical Event">
  <PageHeader width="wide">Legal &amp; Attributions</PageHeader>

  <Section width="wide">
    <Card>
      <h2 slot="title">Disclaimer</h2>
      <p>
        Magical Event is an independent, volunteer-run community event celebrating magic and
        fandom broadly, including themes inspired by popular wizarding-world fiction.
      </p>
      <p>
        We are not affiliated with, endorsed by, or sponsored by any rights holder connected
        to any franchise referenced by our theming. Any resemblance to copyrighted characters,
        settings, or terminology is offered in the spirit of fan celebration, not commercial
        exploitation.
      </p>
      <p>
        All event names, character portrayals, and thematic elements are created and
        performed by independent volunteers and local community members as part of a free,
        non-commercial community event.
      </p>
    </Card>

    <Card class="commitment-card">
      <h2 slot="title">Our Commitment</h2>
      <p>
        As we listen more thoughtfully than ever to our LGBTQIA+ fans and community members of
        color, we are changed. The road ahead is long, challenging, and not soon over. But we
        believe it is worth it. We stand for inclusivity and equal rights.
      </p>
      <p>
        Magical Event loves and values all people in its community. We support
        trans/non-binary bodies, the LGBTQIA+ community, and believe that Black Lives Matter.
      </p>
    </Card>

    <Card>
      <h2 slot="title">Attributions</h2>
      <div class="attributions" set:html={attributionHtml} />
      <p class="attributions__note">
        House icons are used under <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer" class="focus-glow">CC BY 3.0</a> and have not been modified.
      </p>
    </Card>
  </Section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    font-weight: 400;
    color: var(--color-surface-gold);
    margin: 0 0 0.75rem;
  }

  p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .attributions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .attributions :global(a),
  .attributions__note a {
    color: inherit;
    text-decoration: underline;
  }

  .attributions__note {
    margin: 0;
  }
</style>
