---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { Diamond, ExternalLink } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Divider from "@/components/Divider.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";

interface PressLink {
  publication: string;
  title: string;
  url: string;
}

// Placeholder press mentions — swap for real coverage once there is any.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const pressLinks: PressLink[] = [
  {
    publication: "Lorem Ipsum Weekly",
    title: "Lorem Ipsum Dolor Sit Amet Consectetur",
    url: "#",
  },
  {
    publication: "The Dolor Gazette",
    title: "Adipiscing Elit Sed Do Eiusmod Tempor",
    url: "#",
  },
  {
    publication: "Consectetur Times",
    title: "Incididunt Ut Labore Et Dolore Magna",
    url: "#",
  },
];
---

<BaseLayout title="About — Magical Event">
  <PageHeader width="wide">How it all started</PageHeader>

  <Section width="wide">
    <Card>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
        incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
        exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
      <div class="about-card-divider" role="presentation" aria-hidden="true">
        <span class="about-card-divider__line about-card-divider__line--start"></span>
        <Diamond class="about-card-divider__ornament" size={12} aria-hidden="true" />
        <span class="about-card-divider__line about-card-divider__line--end"></span>
      </div>
      <p>
        Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat
        nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
        officia deserunt mollit anim id est laborum.
      </p>
      <div class="about-card-divider" role="presentation" aria-hidden="true">
        <span class="about-card-divider__line about-card-divider__line--start"></span>
        <Diamond class="about-card-divider__ornament" size={12} aria-hidden="true" />
        <span class="about-card-divider__line about-card-divider__line--end"></span>
      </div>
      <p>
        Magical Event is a homegrown celebration, built for anyone who wants to spend a day
        somewhere a little more magical. Here's what people have been saying about it along
        the way.
      </p>
    </Card>

    <Divider />

    <Card>
      <h2 slot="title">In the press</h2>
      <ul class="press-list">
        {
          /* `button` class carries no Button.astro styling here (that's scoped to its own
             component) — it only opts this row-style link out of Section's global inline-link
             underline via its documented `a:not(.button)` exclusion. */
        }
        {
          pressLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="press-link button focus-glow"
              >
                <span class="press-link__text">
                  <span class="press-link__publication">{link.publication}</span>
                  <span class="press-link__title">{link.title}</span>
                </span>
                <ExternalLink
                  class="press-link__icon"
                  aria-hidden="true"
                  focusable="false"
                  size={18}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </Card>
  </Section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 400;
    margin: 0;
    color: var(--color-surface-gold);
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .about-card-divider {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 14rem;
    margin-block: 0.5rem;
    margin-inline: auto;
  }

  .about-card-divider__line {
    flex: 1;
    height: 1px;
  }

  .about-card-divider__line--start {
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--color-surface-gold) 55%, transparent)
    );
  }

  .about-card-divider__line--end {
    background: linear-gradient(
      to left,
      transparent,
      color-mix(in srgb, var(--color-surface-gold) 55%, transparent)
    );
  }

  .about-card-divider__ornament {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--color-surface-gold) 70%, transparent);
  }

  .press-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .press-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    color: var(--color-surface-text);
    text-decoration: none;
  }

  .press-link:hover,
  .press-link:focus-visible {
    border-color: var(--color-surface-primary);
  }

  .press-link:hover .press-link__title,
  .press-link:focus-visible .press-link__title {
    color: var(--color-surface-gold-active);
  }

  .press-link__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .press-link__publication {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .press-link__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-surface-gold);
  }

  .press-link__icon {
    flex-shrink: 0;
    opacity: 0;
    color: var(--color-surface-primary);
  }

  .press-link:hover .press-link__icon,
  .press-link:focus-visible .press-link__icon {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .press-link__icon {
      transform: translate(-4px, 4px);
      transition:
        opacity 0.15s ease-out,
        transform 0.15s ease-out;
    }

    .press-link:hover .press-link__icon,
    .press-link:focus-visible .press-link__icon {
      transform: translate(0, 0);
    }
  }
</style>
