interface Faq {
  question: string;
  /** Trusted static HTML authored on this page — may contain inline <a> links. */
  answer: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const faqs: Faq[] = [
  {
    question: "How do I get tickets to the festival?",
    answer:
      "<p>QCMM is a free festival and no tickets are needed to attend. Some events hosted by participating businesses and non-profits may require tickets and/or registration. Check the “Events” tab on our Facebook page and/or check Sched to see which events require a ticket.</p>",
  },
  {
    question: "Where can I park?",
    answer:
      "<p>LIMITED parking is available downtown at either of the parking garages located on New St. and Johnson St.; both are available despite the street closures. If parking in the New St. garage, please be mindful of the spaces reserved for hotel guests.</p><p>Parking for our free shuttles is also available at the former Staunton Mall on SATURDAY ONLY. Parking at this location is free but festival-goers should ONLY PARK IN THE BACK SECTION. The best way to route your GPS to that entrance (and avoid causing any trouble or potentially getting towed) is to navigate to Pendleton Community Bank at 478 FRONTIER DRIVE. The portion of the shuttle lot that we are authorized to use is ACROSS FRONTIER DRIVE from that bank. Our free shuttles will be available to take you from this location to the center of the festival downtown.</p>",
  },
  {
    question: "Is there handicapped parking available?",
    answer:
      "<p>Handicapped parking is available in the City National Bank parking lot between Central Ave. and Lewis St. Look for volunteers from the Virginia Women’s Institute for Leadership Cadets in fatigues to gain access.</p>",
  },
  {
    question: "When can I catch the shuttle to and from the festival?",
    answer:
      "<p>Free shuttles will run from the former Staunton Mall to downtown throughout the day on SATURDAY ONLY. Shuttle service will begin at 8am Saturday morning and run on an ongoing basis until 10pm. Sunday is traditionally a slower festival day and guests can usually access parking downtown.</p>",
  },
  {
    question: "Will I be able to drive downtown?",
    answer:
      "<p>While you will still be able to drive in the downtown area, there will be street closures, congestion, and confusion. The traffic map (found on our website and posted on our social media) shows which streets will be accessible. Street closures have also been uploaded to Waze so we encourage you to utilize that app while out and about downtown.</p>",
  },
  {
    question: "How can I see the whole festival schedule?",
    answer:
      '<p>Visit <a href="https://qcmm25.sched.com/" target="_blank" rel="noopener noreferrer" class="focus-glow">qcmm25.sched.com</a> to find the most complete and up-to-date schedule of events, activities, and festival amenities. You can also download the (free) Sched app. A limited number of logins are available for attendees to create their own personalized schedule but a login is not needed to access the information in Sched.</p>',
  },
  {
    question: "Where can I find festival maps?",
    answer:
      "<p>In an effort to reduce paper waste, we no longer print individual maps. Large versions of the map will be posted around the festival and smaller maps (for review only) can be found at the Information Booth. The map can be found on our website, social media, and in Sched.</p>",
  },
  {
    question: "What time do the trains with characters arrive?",
    answer:
      "<p>Special guests will be arriving by train, provided by Buckingham Branch, four times during QCMM 2025: Saturday and Sunday at 9:45 AM and 2:45 PM. All trains will arrive at the Staunton Train Station/Platform 9 ¾.</p>",
  },
  {
    question: "Are there public restrooms available?",
    answer:
      "<p>Yes! Passageway to the Ministry of Magic (PortaJohns) can be found between Slytherin and Hufflepuff Blocks.</p>",
  },
  {
    question: "Will you have water available throughout the festival?",
    answer:
      "<p>Yes! Please help us be responsible environmental stewards and bring your own reusable water bottle to QCMM. A water station is hosted by Ciders from Mars and provided by Sutton’s Professional Home Inspections.</p>",
  },
  {
    question: "Where can I change a young wizard’s diaper?",
    answer:
      "<p>Diaper-changing stations can be found at Baja Bean, Byers Street Bistro, Queen City Gifts and Games, and Sunspots. The Frenchman, our brand new café is providing a family rest and nursing area also. Thank you all for this help!</p>",
  },
  {
    question: "Where can I get an official QCMM T-shirt?",
    answer:
      "<p>Official QCMM merchandise is available for sale by the BBC Butterbrew at the intersection of Augusta and Beverley Streets. Quantities and sizes of t-shirts are limited so if there is a particular style and/or size that you are looking for, we suggest making a stop at the Merch Table early in your visit.</p>",
  },
  {
    question:
      "We want to meet some characters and take pictures! What’s the best way to do that?",
    answer:
      "<p>Meet-and-greets with our official characters will take place at several locations within the festival. Characters will also be arriving by train several times each day! Check Sched to find details on which characters will be arriving on each train. Sched will also have the times for each meet-and-greet area.</p>",
  },
  {
    question: "I don’t know my house! Can I be sorted at QCMM?",
    answer:
      "<p>Yes! Sorting by a local Boy Scout Troop will take place at the Wharf near Byers Street throughout the festival.</p>",
  },
  {
    question: "Can I bring Fluffy?",
    answer:
      "<p>As much as we would love to meet your furry friends, due to the number of guests we host and also the wildlife that is part of our programming, our festival environment will not be comfortable for pets. We ask that you please leave Fluffy at home.</p>",
  },
  {
    question: "When and where are the Quidditch matches?",
    answer:
      "<p>The first two matches will be played Saturday at 2:00 and 5:30. The championship match will be Sunday around 3:45, directly following the train arrival. All matches will be played on Johnson Street at the Wharf.</p>",
  },
  {
    question: "Where can I get tickets to the Hogwarts Reunion Banquet?",
    answer:
      "<p>Banquet tickets are available online. Please see the listing in Sched for more information and a link to the feast and/or pancake breakfast.</p>",
  },
  {
    question: "What is new this year?",
    answer:
      "<p>This year we are celebrating a DECADE of MAGIC in STAUNTON! Don’t miss our retrospectives as you wander around. We are hosting a greenhouse with big thanks for Messer Landscape & Bloomaker on Hufflepuff. We have new enormous creatures but will leave it up to you to behold them—DON’T PET! We have added night fun with a Dementor Dance Party on Saturday in front of Gringotts—the vibe is going to be a little darker so consider yourselves warned. More in our usual, sweet brand you’ll be able to watch a duck race, listen to great music, see amazing performers (new and returning!) some with unbelievable creatures, and meet 100+ characters on our streets and in our character spaces. You will also see some physical changes as our historic downtown prepares for some major improvements in our old (and beloved) infrastructure! We moved some of our staging to accommodate the progress.</p>",
  },
];

interface ScheduleEvent {
  time: string;
  title: string;
  location?: string;
}

interface ScheduleStage {
  /** Omitted for the day's main timeline (as opposed to a named performance stage). */
  name?: string;
  events: ScheduleEvent[];
}

interface ScheduleDay {
  day: string;
  stages: ScheduleStage[];
}

