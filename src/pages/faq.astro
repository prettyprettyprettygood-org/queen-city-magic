---

<BaseLayout title="FAQ — Queen City Magic">
  <PageHeader width="wide">Frequently Asked Questions</PageHeader>

  <Section width="wide">
    <Card>
      <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-item__question focus-glow">
              <span>{faq.question}</span>
              <svg
                class="faq-item__chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-item__answer" set:html={faq.answer} />
          </details>
        ))
      }

      <details class="faq-item">
        <summary class="faq-item__question focus-glow">
          <span>Last year&rsquo;s schedule (2025)</span>
          <svg
            class="faq-item__chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="faq-item__answer">
          <p class="schedule-preview-note">
            A preview of last year&rsquo;s lineup while the 2026 schedule is being finalized —
            check back closer to the festival for the current one, or watch{" "}
            <a
              href="https://qcmm25.sched.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="focus-glow"
            >
              qcmm25.sched.com
            </a>{" "}
            directly.
          </p>

          {
            schedule2025.map((day) => (
              <div class="schedule-day">
                <h3>{day.day}</h3>
                {day.stages.map((stage) => (
                  <div class="schedule-stage">
                    {stage.name && <h4>{stage.name}</h4>}
                    <ul>
                      {stage.events.map((event) => (
                        <li>
                          <span class="schedule-time">{event.time}</span>
                          {" — "}
                          {event.title}
                          {event.location && <span class="schedule-location"> ({event.location})</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))
          }

          <div class="schedule-day">
            <h3>Festival Services</h3>
            <p class="schedule-services-subhead">Available Saturday & Sunday</p>
            <ul>
              {
                festivalServices.map((service) => (
                  <li>
                    <span class="schedule-time">{service.name}</span>
                    {" — "}
                    {service.detail}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </details>
      </div>
    </Card>
  </Section>
</BaseLayout>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-surface-border);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 1rem 0.25rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover,
  .faq-item[open] > .faq-item__question {
    color: var(--color-surface-gold-active);
  }

  .faq-item__chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item__chevron {
      transition: transform 0.15s ease-out;
    }
  }

  .faq-item[open] > .faq-item__question .faq-item__chevron {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 0.25rem 1.25rem;
    line-height: 1.6;
  }

  .faq-item__answer :global(p) {
    margin: 0 0 0.85rem;
  }

  .faq-item__answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .schedule-preview-note {
    font-style: italic;
    opacity: 0.85;
  }

  .schedule-day {
    margin-top: 1.5rem;
  }

  .schedule-day:first-child {
    margin-top: 0;
  }

  .schedule-day h3 {
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-surface-primary);
    margin: 0 0 0.5rem;
  }

  .schedule-services-subhead {
    margin: -0.25rem 0 0.5rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .schedule-stage {
    margin-top: 0.85rem;
  }

  .schedule-stage h4 {
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-body);
    margin: 0 0 0.35rem;
    opacity: 0.85;
  }

  .schedule-day ul {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .schedule-time {
    font-weight: 600;
  }

  .schedule-location {
    opacity: 0.75;
  }
</style>
