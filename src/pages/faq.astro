---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Faq {
  question: string;
  /** Trusted static HTML authored on this page — may contain inline <a> links. */
  answer: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const faqs: Faq[] = [
  {
    question: "How do I get tickets to the event?",
    answer:
      "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
  },
  {
    question: "Where can I park?",
    answer:
      "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p><p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>",
  },
  {
    question: "Is there accessible parking available?",
    answer:
      "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
  },
  {
    question: "How can I see the whole event schedule?",
    answer:
      '<p>Visit our <a href="/schedule" class="focus-glow">Schedule</a> page for the most complete and up-to-date list of events, activities, and amenities.</p>',
  },
  {
    question: "Are there public restrooms available?",
    answer:
      "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>",
  },
];
---

<BaseLayout title="FAQ — Magical Event">
  <PageHeader width="wide">Frequently Asked Questions</PageHeader>

  <Section width="wide">
    <p class="faq-intro">
      Answers to the questions we hear most about parking, shuttles, accessibility, and
      getting around the event.
    </p>

    <Card>
      <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-item__question focus-glow">
              <span>{faq.question}</span>
              <svg
                class="faq-item__chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-item__answer" set:html={faq.answer} />
          </details>
        ))
      }

      </div>
    </Card>

    <div class="schedule-cta">
      <p>Curious what a day at Magical Event looks like?</p>
      <Button href="/schedule">View Sample Schedule</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .faq-intro {
    margin: 0;
    line-height: 1.6;
    text-align: center;
    opacity: 0.85;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-surface-border);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 1rem 0.25rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover,
  .faq-item[open] > .faq-item__question {
    color: var(--color-surface-gold-active);
  }

  .faq-item__chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item__chevron {
      transition: transform 0.15s ease-out;
    }
  }

  .faq-item[open] > .faq-item__question .faq-item__chevron {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 0.25rem 1.25rem;
    line-height: 1.6;
  }

  .faq-item__answer :global(p) {
    margin: 0 0 0.85rem;
  }

  .faq-item__answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .schedule-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .schedule-cta p {
    margin: 0;
    line-height: 1.6;
  }
</style>
