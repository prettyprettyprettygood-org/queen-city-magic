---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { CalendarHeart, CircleQuestionMark, Heart } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Divider from "@/components/Divider.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Hero from "@/components/Hero.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import MoodSectionIcon from "@/components/MoodSectionIcon.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import SectionHeader from "@/components/SectionHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Magical Event">
  <Hero />

  <Section id="magic-explained" width="wide">
    <div class="intro">
      <SectionHeader>
        <MoodSectionIcon slot="icon" />
        The magic explained&hellip;
      </SectionHeader>
      <p class="intro__aside">(consectetur adipiscing elit&ndash;sed do eiusmod tempor incididunt)</p>
      <p class="intro__body">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
        incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
        exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure
        dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
      </p>
    </div>

    <Divider />

    <Card>
      <CalendarHeart slot="icon" size={22} aria-hidden="true" />
      <h2 slot="title">Save the Date</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit — thank you to everyone who
        showed up and made the magic happen last time.
      </p>
      <p>
        Mark your calendars: Magical Event returns <strong>November 26, 2026</strong>, with
        more mischief, magic, mystery and mayhem than ever. We can't wait to see you there.
      </p>
      <Button slot="cta" href="/events">Plan Your Visit</Button>
    </Card>

    <Card>
      <Heart slot="icon" size={22} aria-hidden="true" />
      <h2 slot="title">You Are Welcome Here</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
        incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
        exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
      <Button slot="cta" href="/donate">Help Us Make the Magic</Button>
    </Card>

    <Card>
      <CircleQuestionMark slot="icon" size={22} aria-hidden="true" />
      <h2 slot="title">Learn more</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
        incididunt ut labore et dolore magna aliqua, ut enim ad minim veniam quis nostrud
        exercitation ullamco laboris.
      </p>
      <Button slot="cta" href="/faq">Read the FAQ</Button>
    </Card>
  </Section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    font-weight: 400;
    color: var(--color-surface-gold);
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 38rem;
    margin-inline: auto;
    text-align: center;
  }

  .intro__aside {
    font-style: italic;
    opacity: 0.8;
  }

  .intro__body {
    font-size: 1.2rem;
  }
</style>
