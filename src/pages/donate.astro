---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import SocialLinks from "@/components/SocialLinks.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Donate — Magical Event">
  <PageHeader width="wide">Help us make the magic!</PageHeader>

  <Section width="wide" class="donate-section">
    <Card class="donate-card">
      <div class="donate-intro">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <p>
          Magical Event is free to attend and run almost entirely by volunteers — but putting
          on an event like this takes real resources, and every donation helps make it happen.
        </p>
        <p>
          Please donate today to keep us going. We depend on our volunteers and generous
          donors like you — thank you!
        </p>
      </div>

      <div class="ko-fi">
        <Button href="https://ko-fi.com/prettyprettyprettygood" external>Donate on Ko-fi</Button>
      </div>

      <div class="donate-socials">
        <p class="donate-socials__label">Follow the festival</p>
        <SocialLinks />
      </div>
    </Card>
  </Section>
</BaseLayout>

<style>
  :global(.donate-section) {
    padding-top: clamp(1rem, 4vw, 2rem);
  }

  :global(.donate-section .section__inner) {
    gap: 1.5rem;
  }

  :global(.donate-card .card__body) {
    gap: 2.5rem;
  }

  p {
    margin: 0;
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    line-height: 1.6;
    text-align: center;
  }

  .donate-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ko-fi {
    display: flex;
    justify-content: center;
  }

  .donate-socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .donate-socials__label {
    margin: 0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
</style>
