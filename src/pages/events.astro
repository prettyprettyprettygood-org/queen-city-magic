---
import { getCollection } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Divider from "@/components/Divider.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import EventCard from "@/components/EventCard.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";

const events = await getCollection("events");
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const upcomingEvents = events.filter(({ data }) => data.status === "upcoming");
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const pastEvents = events.filter(({ data }) => data.status === "past");
---

<BaseLayout title="Events — Magical Event" description="Upcoming events at Magical Event.">
  <PageHeader width="wide">Events</PageHeader>

  <Section width="wide">
    <section>
      <div class="event-grid">
        {upcomingEvents.map((event) => <EventCard event={event} />)}
      </div>
    </section>

    {pastEvents.length > 0 && (
      <>
        <Divider />
        <section class="past-events" aria-labelledby="past-heading">
          <h2 id="past-heading">Past Events</h2>
          <div class="event-grid">
            {pastEvents.map((event) => <EventCard event={event} />)}
          </div>
        </section>
      </>
    )}
  </Section>
</BaseLayout>

<style>
  section,
  .past-events {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  h2 {
    margin: 0;
    color: var(--color-surface-gold);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 400;
  }

  .event-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .past-events {
    opacity: 0.82;
  }

</style>
