---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { ExternalLink } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Divider from "@/components/Divider.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Gallery from "@/components/Gallery.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import PageHeader from "@/components/PageHeader.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Gallery — Queen City Magic">
  <PageHeader width="wide">Gallery</PageHeader>

  <Section width="wide">
    <Gallery />

    <Divider />

    <div class="video-frame">
      <iframe
        title="QCMM highlight video"
        src="https://player.vimeo.com/video/1108443655?h=5a7827b3eb&dnt=1"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <Divider />

    <Card>
      <h2 slot="title">Unforgettable Memories: Queen City Magic in Pictures</h2>
      <p>
        You're about to leave queencitymagic.com. Our ten years of photos live on Pixieset, a
        third-party gallery, and you may need the event password to view them.
      </p>
      <Button
        slot="cta"
        href="https://kate-simon.pixieset.com/guestlogin/queencitymischiefandmagic/?return=%2Fqueencitymischiefandmagic%2F"
        external
      >
        View Pixieset Gallery
        <ExternalLink class="pixieset-icon" size={16} aria-hidden="true" />
      </Button>
    </Card>
  </Section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--color-surface-gold);
    margin: 0 0 0.5rem;
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-control);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pixieset-icon {
    width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-0.25rem);
    transition: width 0.15s ease-out, margin-left 0.15s ease-out, opacity 0.15s ease-out,
      transform 0.15s ease-out;
  }

  :global(.button:hover) .pixieset-icon,
  :global(.button:focus-visible) .pixieset-icon {
    width: 1rem;
    margin-left: 0.4rem;
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .pixieset-icon {
      transition: none;
    }
  }

</style>
