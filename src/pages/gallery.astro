---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Gallery from "@/components/Gallery.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Section from "@/components/Section.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Gallery — Queen City Magic">
  <Section width="wide">
    <Card>
      <h1 slot="title">Gallery</h1>

      <Gallery />

      <h2>See a sneak peak</h2>
      <div class="video-frame">
        <iframe
          title="QCMM highlight video"
          src="https://player.vimeo.com/video/1108443655?h=5a7827b3eb&dnt=1"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </Card>
  </Section>

  <Section>
    <Card>
      <h2 slot="title">Unforgettable Memories: Queen City Magic in Pictures</h2>
      <p>Explore the full archive of festival pictures from the past ten years.</p>
      <Button slot="cta" href="/ten-years">10 years</Button>
    </Card>
  </Section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 400;
    margin: 0;
    color: var(--color-surface-primary);
  }

  h2 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--color-surface-primary);
    margin: 0 0 0.5rem;
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-control);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

</style>
