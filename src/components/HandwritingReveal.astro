---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import {
  HERO_EYEBROW_PATH_D,
  HERO_EYEBROW_TEXT,
  HERO_EYEBROW_VIEW_BOX,
} from "@/components/hero-eyebrow-path";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import ParticleField from "@/components/ParticleField.astro";

interface Props {
  class?: string;
  /**
   * Delay, in ms, before the pen starts drawing. Applied from page load if `waitForEvent` is
   * unset, or after that event fires (as a small breathing-room buffer) if it is.
   */
  startDelayMs?: number;
  /** Name of a `document`-dispatched event to wait for before the delay above starts counting — lets a caller sequence this after another animation of unknown/variable duration finishes, rather than guessing a fixed delay. */
  waitForEvent?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { class: className, startDelayMs = 0, waitForEvent } = Astro.props;
---

<!--
  Renders the actual "Nothing You Could Do" glyph outlines for "You belong here" (see
  hero-eyebrow-path.ts, generated by scripts/generate-eyebrow-path.mjs) as one solid gold path
  — always at full opacity, correct weight, from first paint — and reveals it left to right with
  a clip-path rectangle that widens over time, rather than animating the outline itself. (Two
  earlier approaches didn't work: stroke-dasharray/dashoffset can't sequence multiple disjoint
  letter subpaths sharing one <path> — each reveals in parallel from its own start rather than
  in sequence — and splitting the letters into separate <path> elements to work around that
  broke the nonzero-winding-rule holes in letters like e/o/g/b, since an inner counter-contour
  only reads as a hole when filled together with its outer contour in the same path.) Base
  render (no JS, or reduced motion) is the solid glyph with no clip at all — the script only
  adds the clip-path once it confirms it's here and motion is safe.
-->
<span class={className} data-handwriting data-start-delay={startDelayMs} data-wait-for-event={waitForEvent}>
  <svg
    class="handwriting-svg"
    viewBox={HERO_EYEBROW_VIEW_BOX}
    role="img"
    aria-label={HERO_EYEBROW_TEXT}
  >
    <path class="handwriting-path" d={HERO_EYEBROW_PATH_D}></path>
  </svg>
  <ParticleField waitForEvent="handwriting-complete" particleCount={24} />
</span>

<style>
  [data-handwriting] {
    position: relative;
    display: inline-block;
  }

  .handwriting-svg {
    display: block;
    height: clamp(2.15rem, 4.3vw, 2.9rem);
    width: auto;
    overflow: visible;
  }

  .handwriting-path {
    fill: var(--color-surface-eyebrow);
    /*
      A matching stroke thickens the traced glyph outlines a touch, faking a slightly bolder
      weight — there's no font-weight to reach for once the letterforms are already a fixed
      vector path. stroke-width is in the path's own viewBox units (see HERO_EYEBROW_VIEW_BOX,
      ~1250 units tall), not CSS px, so this is a small fraction of the glyph height.
    */
    stroke: var(--color-surface-eyebrow);
    stroke-width: 14;
    stroke-linejoin: round;
  }
</style>

<script>
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const SVG_NS = "http://www.w3.org/2000/svg";

  // Gentle ease-in-out instead of a constant rate — a steady linear sweep is what reads as
  // mechanical/typewriter-like; easing the pen's speed is what reads as a hand actually moving.
  const easeInOutSine = (x: number) => -(Math.cos(Math.PI * x) - 1) / 2;

  const DRAW_MS = 3400;
  let clipIdCounter = 0;

  document.querySelectorAll<HTMLElement>("[data-handwriting]").forEach((wrapper) => {
    if (reducedMotionQuery.matches) return;

    const startDelayMs = Number(wrapper.dataset.startDelay) || 0;
    const waitForEvent = wrapper.dataset.waitForEvent;
    const svg = wrapper.querySelector<SVGSVGElement>(".handwriting-svg");
    const pathEl = wrapper.querySelector<SVGPathElement>(".handwriting-path");
    if (!svg || !pathEl) return;

    const viewBox = svg.viewBox.baseVal;
    const minX = viewBox.x;
    const maxX = viewBox.x + viewBox.width;

    // A clip-path rect widening left to right — reveals the one solid path (correct weight,
    // correct e/o/g/b holes, since it's never split apart) up to the current pen position,
    // instead of animating the outline. No clipPath styling needed, so the scoped-CSS/
    // data-astro-cid mismatch that bit the split-path approach doesn't apply here.
    const clipId = `handwriting-clip-${clipIdCounter++}`;
    const clipPath = document.createElementNS(SVG_NS, "clipPath");
    clipPath.setAttribute("id", clipId);
    const rect = document.createElementNS(SVG_NS, "rect");
    rect.setAttribute("x", String(minX));
    rect.setAttribute("y", String(viewBox.y));
    rect.setAttribute("width", "0");
    rect.setAttribute("height", String(viewBox.height));
    clipPath.appendChild(rect);
    svg.appendChild(clipPath);
    pathEl.setAttribute("clip-path", `url(#${clipId})`);

    const beginDraw = () => {
      setTimeout(() => {
        const start = performance.now();

        const frame = (now: number) => {
          const t = Math.min(1, (now - start) / DRAW_MS);
          const eased = easeInOutSine(t);
          rect.setAttribute("width", String(eased * (maxX - minX)));

          if (t < 1) {
            requestAnimationFrame(frame);
          } else {
            // ParticleField listens for this on `wrapper` (its own parent element) to hold off
            // sparkling until the pen-draw reveal finishes, rather than appearing underneath it
            // mid-draw.
            wrapper.dispatchEvent(new CustomEvent("handwriting-complete"));
          }
        };
        requestAnimationFrame(frame);
      }, startDelayMs);
    };

    if (waitForEvent) {
      document.addEventListener(waitForEvent, beginDraw, { once: true });
    } else {
      beginDraw();
    }
  });
</script>
