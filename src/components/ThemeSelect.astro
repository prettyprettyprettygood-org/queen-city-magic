---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { Shield, ShieldQuestionMark } from "@lucide/astro";

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const themes = [
  {
    value: "twilight",
    label: "House Color",
    color: "var(--color-twilight-shield)",
    bg: "var(--color-twilight-950)",
    icon: "shield-question",
  },
  {
    value: "daring",
    label: "Daring Red",
    color: "var(--color-daring-primary)",
    bg: "var(--color-daring-bg)",
    icon: "shield",
  },
  {
    value: "ambitious",
    label: "Ambitious Green",
    color: "var(--color-ambitious-primary)",
    bg: "var(--color-ambitious-bg)",
    icon: "shield",
  },
  {
    value: "clever",
    label: "Clever Blue",
    color: "var(--color-clever-primary)",
    bg: "var(--color-clever-bg)",
    icon: "shield",
  },
  {
    value: "loyal",
    label: "Loyal Yellow",
    color: "var(--color-loyal-primary)",
    bg: "var(--color-loyal-bg)",
    icon: "shield",
  },
] as const;
---

<div class="select" data-theme-select>
  <details class="select-details">
    <summary class="select-trigger focus-glow">
      <span class="select-trigger-label">House Color</span>
      <svg
        class="select-chevron"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <div class="select-options">
      <fieldset class="select-fieldset">
        <legend class="sr-only">Choose a color theme</legend>
        {
          themes.map((theme) => (
            <label class="option-label">
              <input
                type="radio"
                name="qcmm-theme"
                class="option-radio"
                value={theme.value}
                checked={theme.value === "twilight"}
              />
              <span class="option-icon-chip" style={`background-color:${theme.bg}`}>
                {theme.icon === "shield-question" ? (
                  // Left unfilled (stroke only) — filling this solid like the others would
                  // paint over the question-mark glyph in the same color, hiding it.
                  <ShieldQuestionMark class="option-icon" color={theme.color} size={14} stroke-width={1.5} />
                ) : (
                  <Shield class="option-icon" color={theme.color} fill={theme.color} size={14} stroke-width={1.5} />
                )}
              </span>
              <span class="option-text">{theme.label}</span>
            </label>
          ))
        }
      </fieldset>
      <div class="sound-divider" aria-hidden="true" role="presentation"></div>
      <button type="button" class="option-label sound-toggle focus-glow" data-sound-toggle aria-pressed="false">
        <span class="option-text">Sound: Off</span>
      </button>
    </div>
  </details>
</div>

<style>
  .select {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
  }

  .select-details > summary {
    list-style: none;
  }
  .select-details > summary::-webkit-details-marker {
    display: none;
  }

  .select-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    background-color: var(--color-surface-panel);
    color: var(--color-surface-text);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .select-chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .select-chevron {
      transition: transform 0.15s ease-out;
    }
  }

  .select-details[open] .select-chevron {
    transform: rotate(180deg);
  }

  .select-options {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 100%;
    padding: 0.35rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    background-color: var(--color-surface-panel);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .select-fieldset {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border: none;
    margin: 0;
    padding: 0;
  }

  .option-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.6rem;
    border-radius: calc(var(--radius-control) - 0.15rem);
    color: var(--color-surface-text);
    cursor: pointer;
    white-space: nowrap;
  }

  .option-label:hover {
    background-color: var(--color-surface-border);
  }

  .option-label:has(.option-radio:focus-visible) {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-surface-glow),
      0 0 12px 2px color-mix(in srgb, var(--color-surface-glow) 55%, transparent);
  }

  .option-label:has(.option-radio:checked) {
    color: var(--color-surface-primary);
    font-weight: 600;
  }

  .sound-divider {
    height: 1px;
    margin: 0.35rem 0;
    background-color: var(--color-surface-border);
  }

  .sound-toggle {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--color-surface-text);
    font: inherit;
    text-align: left;
  }

  .sound-toggle:hover {
    background-color: var(--color-surface-border);
  }

  .option-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .option-icon-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: calc(var(--radius-control) - 0.15rem);
    border: 1px solid var(--color-surface-border);
    flex-shrink: 0;
  }

  .option-icon {
    flex-shrink: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const STORAGE_KEY = "qcmm-theme";

  document.querySelectorAll<HTMLElement>("[data-theme-select]").forEach((select) => {
    const details = select.querySelector<HTMLDetailsElement>(".select-details");
    const summaryLabel = select.querySelector<HTMLElement>(".select-trigger-label");
    const radios = select.querySelectorAll<HTMLInputElement>(".option-radio");
    if (!details || !summaryLabel) return;

    const syncLabel = () => {
      const checked = select.querySelector<HTMLInputElement>(".option-radio:checked");
      const text = checked?.closest(".option-label")?.querySelector(".option-text")?.textContent;
      if (text) summaryLabel.textContent = text;
    };

    const current = document.documentElement.dataset.theme ?? "twilight";
    const initial = select.querySelector<HTMLInputElement>(`.option-radio[value="${current}"]`);
    if (initial) initial.checked = true;
    syncLabel();

    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        syncLabel();
        details.removeAttribute("open");
        document.documentElement.dataset.theme = radio.value;
        localStorage.setItem(STORAGE_KEY, radio.value);
      });
    });

    document.addEventListener("click", (event) => {
      if (details.open && !details.contains(event.target as Node)) {
        details.removeAttribute("open");
      }
    });

    details.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        details.removeAttribute("open");
        details.querySelector("summary")?.focus();
      }
    });
  });
</script>
