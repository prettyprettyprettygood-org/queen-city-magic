---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { CalendarDays, ExternalLink, MapPin } from "@lucide/astro";
import magicBook from "@/assets/images/gallery/magic-book.jpg";
import magicPotions from "@/assets/images/gallery/magic-potions.jpg";
import magicTown from "@/assets/images/gallery/magic-town.jpg";
import magicWandKid from "@/assets/images/gallery/magic-wand-kid.jpg";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Card from "@/components/Card.astro";

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const { data } = event;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const isPast = data.status === "past";
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const isExternal = data.primaryLink?.url.startsWith("http") ?? false;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const image = {
  "magic-book": magicBook,
  "magic-potions": magicPotions,
  "magic-town": magicTown,
  "magic-wand-kid": magicWandKid,
}[data.image ?? ""];
---

<Card class="event-card">
  {image && <Image slot="media" class="event-card__image" src={image} alt={`Image for ${data.title}`} />}
  <div class="event-card__meta" aria-label="Event details">
    {!isPast && <span><CalendarDays size={16} aria-hidden="true" />{data.dateLabel}</span>}
    <span class="event-card__location-chip"><MapPin size={16} aria-hidden="true" />{data.location}</span>
  </div>
  {isPast ? (
    <div slot="title" class="event-card__title-row">
      <h3>{data.title}</h3>
      <span class="event-card__date-chip">{data.dateLabel}</span>
    </div>
  ) : (
    <h3 slot="title">{data.title}</h3>
  )}
  <p>{data.description}</p>
  {data.primaryLink && (
    <div slot="cta" class="event-card__actions">
      <Button href={data.primaryLink.url} external={isExternal}>
        {data.primaryLink.label}
        {isExternal && <span class="sr-only"> (opens external site)</span>}
        {isExternal && <ExternalLink class="event-card__external-icon" size={16} aria-hidden="true" />}
      </Button>
      {data.secondaryLink && (
        <Button href={data.secondaryLink.url} external>
          {data.secondaryLink.label}
          <span class="sr-only"> (opens external site)</span>
          <ExternalLink class="event-card__external-icon" size={16} aria-hidden="true" />
        </Button>
      )}
    </div>
  )}
</Card>

<style>
  :global(.event-card) {
    gap: 0.65rem;
  }

  :global(.event-card .card__body) {
    gap: 1rem;
  }

  .event-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-control);
  }

  :global(.event-card.event-card:has(.event-card__image)) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    column-gap: 1.5rem;
  }

  :global(.event-card.event-card:has(.event-card__image) .card__media) {
    grid-column: 1;
    grid-row: 1 / 4;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-control);
  }

  :global(.event-card.event-card:has(.event-card__image) .card__header) {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
  }

  :global(.event-card.event-card:has(.event-card__image) .card__body) {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }

  :global(.event-card.event-card:has(.event-card__image) .card__cta) {
    grid-column: 2;
    grid-row: 3;
    align-self: end;
    justify-content: flex-end;
  }

  .event-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    color: color-mix(in srgb, var(--color-surface-card-text) 78%, transparent);
    font-size: 0.95rem;
  }

  .event-card__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .event-card__location-chip {
    padding: 0.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-surface-glow) 55%, transparent);
    border-radius: 999px;
    color: var(--color-surface-gold);
    font-size: 0.85rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 400;
  }

  .event-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .event-card__date-chip {
    flex: 0 1 auto;
    max-width: 48%;
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-surface-glow) 55%, transparent);
    border-radius: 999px;
    color: var(--color-surface-gold);
    font-size: 0.85rem;
    line-height: 1.25;
    text-align: right;
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .event-card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    width: 100%;
    gap: 0.65rem;
  }

  .event-card__actions :global(.button) {
    gap: 0.4rem;
  }

  .event-card__external-icon {
    width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-0.25rem);
    transition: width 0.15s ease-out, margin-left 0.15s ease-out, opacity 0.15s ease-out,
      transform 0.15s ease-out;
  }

  .event-card__actions :global(.button:hover) .event-card__external-icon,
  .event-card__actions :global(.button:focus-visible) .event-card__external-icon {
    width: 1rem;
    margin-left: 0.4rem;
    opacity: 1;
    transform: translateX(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 46rem) {
    :global(.event-card.event-card:has(.event-card__image)) {
      grid-template-columns: 1fr;
    }

    :global(.event-card.event-card:has(.event-card__image) .card__media),
    :global(.event-card.event-card:has(.event-card__image) .card__header),
    :global(.event-card.event-card:has(.event-card__image) .card__body),
    :global(.event-card.event-card:has(.event-card__image) .card__cta) {
      grid-column: 1;
      grid-row: auto;
    }

    .event-card__image {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .event-card__title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .event-card__date-chip {
      max-width: 100%;
      border-radius: var(--radius-control);
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card__external-icon {
      transition: none;
    }
  }
</style>
