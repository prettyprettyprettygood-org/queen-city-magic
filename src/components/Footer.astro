---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { ArrowUp } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import Button from "@/components/Button.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import SocialLinks from "@/components/SocialLinks.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { navLinks } from "@/lib/navLinks";

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <hr class="site-footer__divider" />

    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__wordmark focus-glow">Magical Event</a>
        <p class="site-footer__tagline">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit — a free, community-run
          gathering with themed activities for all ages, set against a backdrop worth
          celebrating.
        </p>
      </div>

      <div class="site-footer__nav-group">
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="site-footer__nav-link focus-glow">
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/legal" class="site-footer__nav-link focus-glow">Attributions &amp; Disclaimer</a>
            </li>
          </ul>
        </nav>

        <SocialLinks />
      </div>

      <div class="site-footer__support">
        <p class="site-footer__support-heading">Help us make the magic!</p>
        <p class="site-footer__support-copy">
          Lorem ipsum dolor sit amet — every contribution from volunteers and donors helps keep
          the magic going, year after year.
        </p>
        <Button href="https://ko-fi.com/prettyprettyprettygood" external class="site-footer__cta">
          Donate
        </Button>
      </div>
    </div>

    <div class="site-footer__bottom">
      <a href="/legal" class="site-footer__badge-chip focus-glow">
        <span aria-hidden="true">🏳️‍🌈</span> Woman-owned &amp; queer-friendly
      </a>

      <div class="site-footer__legal">
        <p class="site-footer__legal-line">
          © {year} Magical Event — All Rights Reserved.
          <span class="site-footer__legal-dot" aria-hidden="true">·</span>
          <a href="mailto:contact@prettyprettyprettygood.org">contact@prettyprettyprettygood.org</a>
        </p>
        <p class="site-footer__credits">
          Built with <span aria-hidden="true">✨</span> by{" "}
          <a href="https://www.prettyprettyprettygood.org/" target="_blank" rel="noopener noreferrer">
            prettyprettyprettygood.org
          </a>
        </p>
      </div>

      <a href="#top" class="site-footer__icon-btn site-footer__back-to-top focus-glow" data-back-to-top aria-label="Back to top">
        <ArrowUp aria-hidden="true" focusable="false" size={18} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    color: var(--color-surface-text);
    font-family: var(--font-body);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 3rem clamp(1.5rem, 5vw, 4rem) 2rem;
  }

  .site-footer__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .site-footer__brand,
  .site-footer__support {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  /* Keep the stacked mobile footer focused; the support CTA returns with the desktop columns. */
  .site-footer__support {
    display: none;
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-surface-gold);
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  .site-footer__tagline,
  .site-footer__support-copy {
    margin: 0;
    max-width: 28rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .site-footer__support-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-surface-gold);
  }

  .site-footer__cta {
    margin-top: 0.25rem;
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--color-surface-text);
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  .site-footer__nav-link:hover {
    color: var(--color-surface-gold-active);
  }

  .site-footer__divider {
    border: none;
    border-top: 1px solid var(--color-surface-border);
    margin: 0 0 2rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    text-align: center;
  }

  .site-footer__badge-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    color: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-footer__badge-chip:hover {
    color: var(--color-surface-gold-active);
    border-color: var(--color-surface-gold-active);
  }

  .site-footer__nav-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 40rem;
  }

  .site-footer__legal-line {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .site-footer__legal-dot {
    margin: 0 0.4rem;
    opacity: 0.6;
  }

  .site-footer__credits {
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-surface-border);
    font-size: 0.75rem;
    opacity: 0.55;
  }

  .site-footer__credits a {
    color: inherit;
    text-decoration: underline;
  }

  .site-footer__credits a:hover {
    color: var(--color-surface-gold-active);
  }

  .site-footer__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    color: var(--color-surface-text);
  }

  .site-footer__icon-btn:hover {
    color: var(--color-surface-gold-active);
    border-color: var(--color-surface-gold-active);
  }

  .site-footer__icon-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: flex-start;
      gap: 3rem;
    }

    .site-footer__brand {
      align-items: flex-start;
      text-align: left;
    }

    .site-footer__nav-group {
      /* Capped only up to the 64rem breakpoint below — narrower than that, an unconstrained
         nav row forces the grid's auto column wide and squeezes the brand/support columns
         down to a word-per-line mess. At 64rem+ there's enough room for the row to sit
         uncapped, so the cap lifts there. */
      max-width: 22rem;
      justify-self: center;
      align-self: center;
    }

    .site-footer__nav-link {
      font-size: 1rem;
    }

    .site-footer__support {
      display: flex;
      align-items: flex-end;
      text-align: right;
      justify-self: end;
    }

    .site-footer__cta {
      align-self: flex-end;
    }

    .site-footer__bottom {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: center;
    }

    .site-footer__badge-chip {
      justify-self: start;
    }

    .site-footer__legal {
      justify-self: center;
      align-items: center;
      text-align: center;
    }

    .site-footer__back-to-top {
      justify-self: end;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__nav-group {
      max-width: none;
    }
  }
</style>

<script>
  const initializeBackToTop = () => document.querySelectorAll<HTMLAnchorElement>("[data-back-to-top]").forEach((link) => {
    if (link.dataset.backToTopInitialized === "true") return;
    link.dataset.backToTopInitialized = "true";

    link.addEventListener("click", (event) => {
      event.preventDefault();
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
      history.pushState(null, "", "#top");
    });
  });

  initializeBackToTop();
  document.addEventListener("astro:page-load", initializeBackToTop);
</script>
