---
/**
 * Shared social icon row — Footer's original markup, pulled out so other pages (Donate) can
 * reuse the same links/icons instead of a parallel copy.
 */
interface Props {
  class?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { class: className } = Astro.props;

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const socialLinks = [
  {
    href: "https://www.facebook.com/prettyprettyprettygoodorg",
    label: "Facebook",
    icon: "facebook",
  },
  {
    href: "https://bsky.app/profile/prettyprettypretty.bsky.social",
    label: "Bluesky",
    icon: "bluesky",
  },
] as const;
---

<div class:list={["social-links", className]}>
  {
    socialLinks.map((social) => (
      <a
        href={social.href}
        class="social-links__icon-btn focus-glow"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.label}
      >
        {social.icon === "facebook" ? (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.887h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.964 1.578 1.32 1.928 3.399c.35 2.079 1.428 8.157 2.428 10.156 1.343 2.687 4.34 3.48 6.644 3.16-3.782.51-4.756 2.24-2.67 4.593.79.892 1.19 1.545 1.67.892.545-.744 1.088-2.03 2-2.03.912 0 1.455 1.286 2 2.03.48.653.88 0 1.67-.892 2.086-2.353 1.112-4.083-2.67-4.593 2.304.32 5.301-.473 6.644-3.16 1-1.999 2.078-8.077 2.428-10.156.35-2.079-.638-2.435-3.274-.594C16.046 4.747 13.087 8.686 12 10.8Z" />
          </svg>
        )}
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-links__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    color: var(--color-surface-text);
  }

  .social-links__icon-btn:hover {
    color: var(--color-surface-gold-active);
    border-color: var(--color-surface-gold-active);
  }

  .social-links__icon-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
