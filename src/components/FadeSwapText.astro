---
interface Props {
  /** Shown in sequence, one at a time; the last line is the resting state. */
  lines: string[];
  /** How long each line holds before advancing to the next, in ms. */
  holdMs?: number;
  /** Fade duration, in ms. */
  fadeMs?: number;
  class?: string;
  /** Per-character type-in stagger + sparkle canvas + glow, instead of a plain opacity fade. */
  magical?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { lines, holdMs = 2200, fadeMs = 400, magical = false } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const className = Astro.props.class;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const finalLine = lines[lines.length - 1];
---

<!--
  Plain CSS opacity transition + vanilla JS timer, no animation library — the reduced-motion
  fallback is pure CSS (motion-reduce:/motion-safe:) so it's correct at first paint, before
  any script runs. Reusable: swap `lines` for any other reveal/disappear/reveal text swap, or
  set `magical` for the per-char stagger + sparkle canvas + glow treatment.
-->
<span
  class={className}
  data-fade-swap
  data-lines={JSON.stringify(lines)}
  data-hold={holdMs}
  data-fade={fadeMs}
  data-magical={magical ? "true" : "false"}
>
  <span class="sr-only">{finalLine}</span>
  <span aria-hidden="true" class="hidden motion-reduce:inline">{finalLine}</span>
  <span aria-hidden="true" class="fade-swap-wrap motion-reduce:hidden">
    {magical && <canvas class="fade-swap-sparkle" aria-hidden="true"></canvas>}
    <span class="fade-swap-text" style={`--fade-swap-duration:${fadeMs}ms`}>{lines[0]}</span>
  </span>
</span>

<style>
  .fade-swap-wrap {
    position: relative;
    display: inline-block;
  }

  .fade-swap-sparkle {
    position: absolute;
    inset: -0.5em -1em;
    pointer-events: none;
    z-index: 0;
  }

  .fade-swap-text {
    position: relative;
    z-index: 1;
    display: inline-block;
    transition: opacity var(--fade-swap-duration, 400ms) ease;
  }
  .fade-swap-text[data-fading="true"] {
    opacity: 0;
  }

  [data-magical="true"] .fade-swap-text {
    white-space: pre-wrap;
    /*
      --color-magic-glow, not --color-surface-glow — the latter is each theme's own saturated
      primary (tuned for focus-ring contrast), which reads as a busy/clashing halo behind gold
      script text on some themes instead of a glow.
    */
    text-shadow:
      0 0 6px var(--color-magic-glow),
      0 0 18px color-mix(in srgb, var(--color-magic-glow) 70%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-magical="true"] :global(.magic-char) {
      display: inline-block;
      opacity: 0;
      transform: translateY(3px) rotate(-1deg);
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }
    [data-magical="true"] :global(.magic-char.on) {
      opacity: 1;
      transform: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  function typeIn(el: HTMLElement, text: string, onDone: () => void) {
    el.textContent = "";
    const spans: HTMLSpanElement[] = [];
    const delays: number[] = [];
    let t = 0;
    for (const ch of text) {
      const span = document.createElement("span");
      span.className = "magic-char";
      span.textContent = ch;
      el.appendChild(span);
      spans.push(span);
      delays.push(t);
      t += ch === " " ? 95 : 48;
    }
    spans.forEach((span, i) => {
      setTimeout(() => span.classList.add("on"), delays[i]);
    });
    setTimeout(onDone, t + 220);
  }

  function initSparkle(canvas: HTMLCanvasElement, wrap: HTMLElement) {
    const context = canvas.getContext("2d");
    if (!context) return;
    const ctx = context;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const palette = ["#c1630b", "#f2b347"];
    const readPalette = () => {
      const styles = getComputedStyle(wrap);
      palette[0] = styles.getPropertyValue("--color-magic-glow").trim() || palette[0];
      palette[1] = styles.getPropertyValue("--color-surface-eyebrow").trim() || palette[1];
    };
    readPalette();

    let width = 0;
    let height = 0;
    function resize() {
      const rect = wrap.getBoundingClientRect();
      width = rect.width + 40;
      height = rect.height + 28;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    const particles = Array.from({ length: 28 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: 0.6 + Math.random() * 1.3,
      vy: 0.08 + Math.random() * 0.12,
      alpha: Math.random(),
      va: (0.004 + Math.random() * 0.008) * (Math.random() < 0.5 ? 1 : -1),
      colorIndex: Math.random() < 0.5 ? 0 : 1,
    }));

    function tick() {
      ctx.clearRect(0, 0, width, height);
      for (const p of particles) {
        p.y -= p.vy;
        if (p.y < -4) p.y = height + 4;
        p.alpha += p.va;
        if (p.alpha > 0.85 || p.alpha < 0.05) p.va *= -1;
        ctx.globalAlpha = Math.min(0.85, Math.max(0.05, p.alpha));
        ctx.fillStyle = palette[p.colorIndex];
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    window.addEventListener("resize", resize);
    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  document.querySelectorAll<HTMLElement>("[data-fade-swap]").forEach((wrapper) => {
    if (reducedMotionQuery.matches) return;

    const lines: string[] = JSON.parse(wrapper.dataset.lines ?? "[]");
    const holdMs = Number(wrapper.dataset.hold) || 2200;
    const fadeMs = Number(wrapper.dataset.fade) || 400;
    const magical = wrapper.dataset.magical === "true";
    const wrap = wrapper.querySelector<HTMLElement>(".fade-swap-wrap");
    const textEl = wrapper.querySelector<HTMLElement>(".fade-swap-text");
    const canvas = wrapper.querySelector<HTMLCanvasElement>(".fade-swap-sparkle");
    if (!wrap || !textEl || lines.length === 0) return;

    if (magical && canvas) initSparkle(canvas, wrap);

    if (!magical) {
      if (lines.length <= 1) return;
      let index = 0;
      const next = () => {
        if (index >= lines.length - 1) return;
        textEl.setAttribute("data-fading", "true");
        setTimeout(() => {
          index += 1;
          textEl.textContent = lines[index];
          textEl.removeAttribute("data-fading");
          setTimeout(next, holdMs);
        }, fadeMs);
      };
      setTimeout(next, holdMs);
      return;
    }

    let index = 0;
    const playLine = () => {
      typeIn(textEl, lines[index], () => {
        if (index >= lines.length - 1) return;
        setTimeout(() => {
          textEl.setAttribute("data-fading", "true");
          setTimeout(() => {
            textEl.removeAttribute("data-fading");
            index += 1;
            playLine();
          }, fadeMs);
        }, holdMs);
      });
    };
    playLine();
  });
</script>
