---
/**
 * Themed content panel — the reusable visual unit every page's sections are built from.
 * Restyle this file once, every page picks it up: Home's card grid, and the single-card
 * wrap on Donate/Gallery/FAQ, all render through here.
 *
 * Icon (`slot="icon"`) and CTA (`slot="cta"`) are both optional — Gallery/FAQ skip the icon,
 * some cards skip the CTA — both wrapper elements collapse via `:empty` when unused, so
 * callers don't need a prop to opt out.
 */
interface Props {
  class?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { class: className } = Astro.props;

interface Mote {
  x: number;
  y: number;
  size: number;
  duration: number;
  delay: number;
  dx: number;
  dy: number;
  opacity: number;
}

const MOTE_COUNT = 14;
// Percent-width band from each edge motes are allowed to land in — keeps the drift confined
// to a mist along the card's perimeter instead of scattered over the body text.
const EDGE_BAND = 14;

const randomEdgeCoord = () =>
  Math.random() < 0.5
    ? Math.random() * EDGE_BAND
    : 100 - Math.random() * EDGE_BAND;

// Randomized once per card render — each card gets its own scatter of drifting sparkle
// points rather than a repeated fixed pattern, so the hover effect reads as particles
// rather than a stamped decoration.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const motes: Mote[] = Array.from({ length: MOTE_COUNT }, () => {
  const alongVerticalEdge = Math.random() < 0.5;
  const x = alongVerticalEdge ? randomEdgeCoord() : Math.random() * 100;
  const y = alongVerticalEdge ? Math.random() * 100 : randomEdgeCoord();
  return {
    x: Math.round(x),
    y: Math.round(y),
    size: Number((1.5 + Math.random() * 2).toFixed(1)),
    duration: Number((1.6 + Math.random() * 1.6).toFixed(2)),
    delay: Number((Math.random() * 0.8).toFixed(2)),
    dx: Math.round((Math.random() - 0.5) * 20),
    dy: Math.round(-8 - Math.random() * 16),
    opacity: Number((0.45 + Math.random() * 0.35).toFixed(2)),
  };
});
---

<div class:list={["card", className]}>
  <div class="card__glow" aria-hidden="true"></div>
  <div class="card__motes" aria-hidden="true">
    {
      motes.map((mote) => (
        <span
          class="card__mote"
          style={`--mote-x:${mote.x}%; --mote-y:${mote.y}%; --mote-size:${mote.size}px; --mote-duration:${mote.duration}s; --mote-delay:${mote.delay}s; --mote-dx:${mote.dx}px; --mote-dy:${mote.dy}px; --mote-opacity:${mote.opacity};`}
        />
      ))
    }
  </div>

  <div class="card__header">
    <div class="card__icon">
      <slot name="icon" />
    </div>
    <div class="card__title">
      <slot name="title" />
    </div>
  </div>
  <div class="card__body">
    <slot />
  </div>
  <div class="card__cta">
    <slot name="cta" />
  </div>
</div>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: calc(var(--radius-control) * 2);
    /* Card color is a house token, so light and house-tinted dark cards need no component overrides. */
    background-color: var(--color-surface-card);
    color: var(--color-surface-card-text);
    /* Descendants keep using the same semantic roles, but resolve them for this card surface. */
    --surface-primary: var(--surface-card-heading);
    --surface-border: color-mix(in srgb, var(--surface-card-text) 24%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .card__glow {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    /* Deliberately faint — the sparkle motes are the primary hover cue, this is just ambient support. */
    box-shadow: 0 0 22px 2px color-mix(in srgb, var(--color-surface-accent) 14%, transparent);
  }

  .card__motes {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .card__mote {
    position: absolute;
    left: var(--mote-x);
    top: var(--mote-y);
    width: var(--mote-size);
    height: var(--mote-size);
    border-radius: 999px;
    /* Soft-edged radial fade instead of a solid-filled dot — reads as a fine mist point rather
       than a stamped circle. */
    background: radial-gradient(
      circle,
      var(--color-surface-accent) 0%,
      color-mix(in srgb, var(--color-surface-accent) 45%, transparent) 45%,
      transparent 75%
    );
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card__glow {
      transition: opacity 0.25s ease-out;
    }

    .card:hover .card__mote,
    .card:focus-within .card__mote {
      animation: card-mote-drift var(--mote-duration) ease-in-out var(--mote-delay) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__mote,
    .card:focus-within .card__mote {
      opacity: var(--mote-opacity);
    }
  }

  @keyframes card-mote-drift {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0) scale(0.5);
    }
    40%,
    60% {
      opacity: var(--mote-opacity);
    }
    50% {
      transform: translate(var(--mote-dx), var(--mote-dy)) scale(1);
    }
  }

  .card:hover .card__glow,
  .card:focus-within .card__glow {
    opacity: 1;
  }

  .card__header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-surface-accent) 18%, transparent);
    color: color-mix(in srgb, var(--color-surface-text) 72%, transparent);
  }

  .card__icon:empty {
    display: none;
  }

  .card:hover .card__icon,
  .card:focus-within .card__icon {
    color: var(--color-surface-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card__icon {
      transition: color 0.2s ease-out;
    }

    .card:hover .card__icon :global(svg),
    .card:focus-within .card__icon :global(svg) {
      animation: card-icon-wiggle 0.5s ease-in-out;
    }
  }

  @keyframes card-icon-wiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-12deg);
    }
    75% {
      transform: rotate(12deg);
    }
  }

  .card__title {
    flex: 1;
  }

  .card__title :global(h1),
  .card__title :global(h2),
  .card__title :global(h3) {
    margin: 0;
    color: var(--color-surface-card-heading);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card__cta {
    display: flex;
    justify-content: flex-end;
  }

  .card__cta:empty {
    display: none;
  }
</style>
