---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { Image } from "astro:assets";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import castleBackground from "@/assets/images/castle-background.png";

interface Props {
  class?: string;
}
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { class: className } = Astro.props;
---

<!--
  Simple scroll parallax: a plain scroll listener nudges the image at a fraction of scroll
  speed via `transform`, not `background-attachment: fixed` (unreliable on mobile Safari) and
  not an animation library. Disabled under prefers-reduced-motion: image stays fixed in place.
-->
<div class={className} data-parallax-image>
  <Image
    src={castleBackground}
    alt=""
    role="presentation"
    widths={[640, 1280]}
    sizes="100vw"
    data-parallax-layer
  />
</div>

<style>
  /*
    Fills the hero edge-to-edge except a small top gap (open "sky" above the towers).
    `object-position: top` (not bottom/center) matters: the source is a fixed ~1.93:1 image
    and most viewport/hero-box ratios need at least some crop to fill both dimensions, and
    the tallest spire's tip sits only ~4% of the image's own height from its top edge.
    Anchoring the crop to the top means any trimmed sliver comes off the flat rock base at
    the bottom instead of the spires.
  */
  [data-parallax-image] {
    position: absolute;
    top: clamp(1.5rem, 5vh, 3.5rem);
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
    /*
      Fades the silhouette's own opaque rock base out near the container's bottom edge instead
      of letting it end in a hard-edged cutoff right at the hero section's boundary — pairs
      with Hero.astro's background gradient, which eases back toward transparent over the same
      stretch so the two layers dissolve together rather than one masking the other's edge.
    */
    mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 96%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 96%);
  }

  /*
    Recolored per theme via tokens.css's --surface-parallax-* custom properties (see there
    for why): every theme is dark mode, so the source PNG's black fill is left untouched
    everywhere at 85% opacity.
  */
  [data-parallax-layer] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: var(--surface-parallax-opacity);
    filter: var(--surface-parallax-tint);
  }
</style>

<script>
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const layer = document.querySelector<HTMLElement>("[data-parallax-layer]");

  if (layer && !reducedMotionQuery.matches) {
    let ticking = false;
    const update = () => {
      const offset = window.scrollY * 0.12;
      layer.style.transform = `translateY(${offset}px)`;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
