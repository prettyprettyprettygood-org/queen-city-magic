---
// Each house's icon remains in the DOM so switching `data-theme` is immediate, without a
// client-side icon re-render.
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import badgerIcon from "@/assets/icons/badger-icon.svg?url";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import crowIcon from "@/assets/icons/crow-icon.svg?url";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import lightningIcon from "@/assets/icons/lightning-icon.svg?url";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import lionIcon from "@/assets/icons/lion-icon.svg?url";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import snakeIcon from "@/assets/icons/snake-icon.svg?url";
---

<span class="house-section-icon" aria-hidden="true">
  <img data-house-icon="twilight" src={lightningIcon} alt="" />
  <img data-house-icon="daring" src={lionIcon} alt="" />
  <img data-house-icon="ambitious" src={snakeIcon} alt="" />
  <img data-house-icon="clever" src={crowIcon} alt="" />
  <img data-house-icon="loyal" src={badgerIcon} alt="" />
</span>

<style>
  .house-section-icon {
    display: inline-flex;
  }

  .house-section-icon img {
    display: none;
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    filter: invert(1);
  }

</style>

<script>
  const syncHouseSectionIcons = () => {
    const theme = document.documentElement.dataset.theme ?? "twilight";

    document.querySelectorAll<HTMLElement>(".house-section-icon").forEach((container) => {
      container.querySelectorAll<HTMLImageElement>("img[data-house-icon]").forEach((icon) => {
        icon.style.display = icon.dataset.houseIcon === theme ? "block" : "none";
      });
    });
  };

  syncHouseSectionIcons();

  const themeObserver = new MutationObserver(syncHouseSectionIcons);
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
