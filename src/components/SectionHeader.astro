---
/**
 * Standard h2 treatment for a section-level heading that sits outside a `Card` — Home's
 * "The magic explained…" intro heading is the only existing instance, and the most
 * fully-realized one, so this extracts its icon-in-circle + heading treatment unchanged.
 * Card's own `slot="title"` styling (`.card__title :global(h1/h2/h3)`) is separate and
 * untouched — this component isn't used inside a Card.
 */
interface Props {
  class?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const { class: className } = Astro.props;
---

<div class:list={["section-header", className]}>
  <div class="section-header__icon">
    <slot name="icon" />
  </div>
  <h2 class="section-header__heading"><slot /></h2>
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .section-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-surface-primary) 18%, transparent);
    color: var(--color-surface-primary);
  }

  .section-header__icon:empty {
    display: none;
  }

  .section-header__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    margin: 0;
    color: var(--color-surface-primary);
  }
</style>
