---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { Menu } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import ThemeSelect from "@/components/ThemeSelect.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { navLinks } from "@/lib/navLinks";

// Static builds (build.format: "directory") resolve Astro.url.pathname with a trailing
// slash (e.g. "/about/") since each page is emitted as a directory's index.html; dev's
// request-based routing doesn't add one. Strip it so comparisons against navLinks hrefs
// (which never have a trailing slash) match in both environments.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
const currentPath = Astro.url.pathname.replace(/(.)\/$/, "$1");
---

<nav
  class:list={["navbar", { "navbar--bordered": currentPath !== "/" }]}
  aria-label="Primary"
  data-navbar
>
  <div class="navbar__bg" aria-hidden="true"></div>
  <audio transition:persist="sound-audio" data-sound-audio preload="auto" muted>
    <source src="/audio/geoffharvey-let-the-mystery-unfold-122118-128k.mp3" type="audio/mpeg" />
  </audio>
  <div class="navbar__inner">
    <a href="/" class="navbar__wordmark focus-glow">Magical Event</a>

    <div class="navbar__end">
      <ul class="navbar__links navbar__links--desktop">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="navbar__link focus-glow"
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="navbar__theme navbar__theme--desktop">
        <ThemeSelect />
      </div>

      <details class="navbar__disclosure">
        <summary class="navbar__toggle focus-glow" aria-label="Open menu">
          <Menu aria-hidden="true" focusable="false" size={22} />
        </summary>
        <div class="navbar__panel">
          <ul class="navbar__links">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="navbar__link focus-glow"
                    aria-current={currentPath === link.href ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="navbar__theme">
            <ThemeSelect />
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 40;
    isolation: isolate;
    font-family: var(--font-body);
  }

  .navbar--bordered {
    border-bottom: 1px solid color-mix(in srgb, var(--color-surface-gold) 40%, transparent);
    box-shadow: 0 1px 6px 0 color-mix(in srgb, var(--color-magic-glow) 25%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .navbar {
      transition: transform 0.25s ease-out;
    }
  }

  .navbar--hidden {
    transform: translateY(-100%);
  }

  .navbar__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-surface-nav-scrim);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
  }

  .navbar--solid .navbar__bg {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .navbar__bg {
      transition: opacity 0.2s ease-out;
    }
  }

  .navbar__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem clamp(1.5rem, 5vw, 4rem);
  }

  .navbar__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .navbar__wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-surface-gold);
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  .navbar__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.25rem;
  }

  .navbar__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--color-surface-text);
    text-decoration: none;
    border-radius: var(--radius-control);
    padding: 0.2rem 0.3rem;
  }

  .navbar__link:hover {
    color: var(--color-surface-gold-active);
  }

  .navbar__link[aria-current="page"] {
    color: var(--color-surface-gold-active);
    font-weight: 600;
  }

  .navbar__link[aria-current="page"]::after {
    position: absolute;
    right: 0.3rem;
    bottom: 0;
    left: 0.3rem;
    height: 2px;
    border-radius: 0;
    background: var(--color-surface-gold-active);
    content: "";
  }

  .navbar__theme {
    display: none;
  }

  .navbar__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    background-color: var(--color-surface-panel);
    color: var(--color-surface-text);
    cursor: pointer;
    list-style: none;
  }

  .navbar__toggle::-webkit-details-marker {
    display: none;
  }

  .navbar__panel {
    position: absolute;
    top: 100%;
    right: clamp(1.5rem, 5vw, 4rem);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 12rem;
    margin-top: 0.5rem;
    padding: 0.75rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-surface-border);
    background-color: var(--color-surface-panel);
    box-shadow: var(--shadow-panel);
  }

  .navbar__panel .navbar__links {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .navbar__panel .navbar__theme {
    display: block;
  }

  /* Desktop: inline links + theme select, hamburger disclosure hidden. */
  @media (min-width: 56rem) {
    .navbar__links--desktop {
      display: flex;
    }

    .navbar__theme--desktop {
      display: block;
    }

    .navbar__disclosure {
      display: none;
    }
  }
</style>

<script>
  const SCROLL_THRESHOLD = 48;
  const HIDE_THRESHOLD = 96;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Re-query `[data-navbar]`/`.navbar__disclosure` live on every call rather than capturing
  // references once — Astro's ClientRouter swaps in a fresh <nav> on each client-side
  // navigation, but this module script (and the window/document listeners it registers) only
  // runs once per session, so stale captured elements would silently stop updating after the
  // first page transition.
  let ticking = false;
  let lastScrollY = window.scrollY;

  const setHidden = (nav: HTMLElement, hidden: boolean) => {
    nav.classList.toggle("navbar--hidden", hidden);
    nav.toggleAttribute("inert", hidden);
  };

  const update = () => {
    const scrollY = window.scrollY;

    document.querySelectorAll<HTMLElement>("[data-navbar]").forEach((nav) => {
      nav.classList.toggle("navbar--solid", scrollY > SCROLL_THRESHOLD);

      const disclosure = nav.querySelector<HTMLDetailsElement>(".navbar__disclosure");
      if (prefersReducedMotion || disclosure?.open) {
        setHidden(nav, false);
      } else if (scrollY <= HIDE_THRESHOLD) {
        setHidden(nav, false);
      } else {
        setHidden(nav, scrollY > lastScrollY);
      }
    });

    lastScrollY = scrollY;
    ticking = false;
  };

  update();
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    },
    { passive: true },
  );

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    document.querySelectorAll<HTMLDetailsElement>(".navbar__disclosure[open]").forEach((details) => {
      if (!details.contains(target)) details.removeAttribute("open");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLDetailsElement>(".navbar__disclosure[open]").forEach((details) => {
      details.removeAttribute("open");
      details.querySelector<HTMLElement>("summary")?.focus();
    });
  });

  const SOUND_STORAGE_KEY = "sound-enabled";
  const audio = document.querySelector<HTMLAudioElement>("[data-sound-audio]");
  const soundPrefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const soundWindow = window as typeof window & {
    __soundController?: { sync: () => void };
  };

  if (soundWindow.__soundController) {
    soundWindow.__soundController.sync();
  } else if (audio) {
    let soundEnabled = localStorage.getItem(SOUND_STORAGE_KEY) === "on";
    let fadeFrame = 0;
    let loopFadeFrame = 0;
    let loopAudio: HTMLAudioElement | undefined;
    let activeAudio = audio;
    let crossfadeStarted = false;
    let wasPlayingBeforeHidden = false;
    const targetVolume = 0.35;
    const loopCrossfadeDuration = 1600;

    const cancelLoopFade = () => {
      cancelAnimationFrame(loopFadeFrame);
      loopFadeFrame = 0;
    };

    const fadeBetweenTracks = (outgoing: HTMLAudioElement, incoming: HTMLAudioElement) => {
      cancelLoopFade();
      const startedAt = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - startedAt) / loopCrossfadeDuration, 1);
        outgoing.volume = targetVolume * (1 - progress);
        incoming.volume = targetVolume * progress;
        if (progress < 1) {
          loopFadeFrame = requestAnimationFrame(step);
        } else {
          outgoing.pause();
          outgoing.currentTime = 0;
          activeAudio = incoming;
          crossfadeStarted = false;
        }
      };
      loopFadeFrame = requestAnimationFrame(step);
    };

    const startNextLoop = () => {
      if (!soundEnabled || crossfadeStarted || !loopAudio || !Number.isFinite(activeAudio.duration)) {
        return;
      }

      const incoming = activeAudio === audio ? loopAudio : audio;
      crossfadeStarted = true;
      incoming.currentTime = 0;
      incoming.volume = 0;
      incoming.muted = false;
      incoming.play().then(
        () => fadeBetweenTracks(activeAudio, incoming),
        () => {
          crossfadeStarted = false;
        },
      );
    };

    const watchForLoopPoint = () => {
      if (!soundEnabled || !loopAudio || crossfadeStarted) return;
      if (activeAudio.duration - activeAudio.currentTime <= loopCrossfadeDuration / 1000) {
        startNextLoop();
      }
    };

    const prepareLoopAudio = () => {
      if (loopAudio) return;
      loopAudio = new Audio(audio.currentSrc || "/audio/geoffharvey-let-the-mystery-unfold-122118-128k.mp3");
      loopAudio.preload = "auto";
      loopAudio.volume = 0;
      loopAudio.addEventListener("timeupdate", watchForLoopPoint);
      loopAudio.addEventListener("ended", startNextLoop);
    };

    const syncSoundToggles = () => {
      document.querySelectorAll<HTMLButtonElement>("[data-sound-toggle]").forEach((toggle) => {
        toggle.setAttribute("aria-pressed", String(soundEnabled));
        const label = toggle.querySelector<HTMLElement>(".option-text");
        if (label) label.textContent = `Sound: ${soundEnabled ? "On" : "Off"}`;
      });
    };

    const fadeVolume = (target: number, onComplete?: () => void) => {
      cancelAnimationFrame(fadeFrame);
      const fadingAudio = activeAudio;
      if (soundPrefersReducedMotion) {
        fadingAudio.volume = target;
        onComplete?.();
        return;
      }

      const start = fadingAudio.volume;
      const startedAt = performance.now();
      const duration = 180;
      const step = (now: number) => {
        const progress = Math.min((now - startedAt) / duration, 1);
        fadingAudio.volume = start + (target - start) * progress;
        if (progress < 1) {
          fadeFrame = requestAnimationFrame(step);
        } else {
          onComplete?.();
        }
      };
      fadeFrame = requestAnimationFrame(step);
    };

    const tryPlayback = () => {
      if (!soundEnabled || !audio.paused) return;
      activeAudio = audio;
      crossfadeStarted = false;
      audio.volume = 0;
      audio.muted = false;
      audio.loop = false;
      audio.addEventListener("timeupdate", watchForLoopPoint);
      audio.addEventListener("ended", startNextLoop);
      const playback = audio.play();
      playback?.then(() => {
        // Start the primary track first. Preparing the crossfade track before
        // this point can compete with the first audio request and make the
        // toggle appear unresponsive on a cold load.
        prepareLoopAudio();
        fadeVolume(targetVolume);
      }).catch((error: unknown) => {
        audio.pause();
        audio.muted = true;
        console.warn("Magical Event sound could not start.", error);
      });
    };

    const disableSound = () => {
      soundEnabled = false;
      localStorage.setItem(SOUND_STORAGE_KEY, "off");
      syncSoundToggles();
      cancelLoopFade();
      loopAudio?.pause();
      loopAudio?.load();
      crossfadeStarted = false;
      fadeVolume(0, () => {
        audio.pause();
        loopAudio?.pause();
        loopAudio && (loopAudio.volume = 0);
        audio.muted = true;
        if (loopAudio) loopAudio.muted = true;
        activeAudio = audio;
      });
    };

    const enableSound = () => {
      soundEnabled = true;
      localStorage.setItem(SOUND_STORAGE_KEY, "on");
      syncSoundToggles();
      tryPlayback();
    };

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        wasPlayingBeforeHidden = !audio.paused || Boolean(loopAudio && !loopAudio.paused);
        if (!wasPlayingBeforeHidden) return;

        cancelLoopFade();
        crossfadeStarted = false;
        audio.pause();
        loopAudio?.pause();
        return;
      }

      if (!wasPlayingBeforeHidden || !soundEnabled || !activeAudio.paused) return;
      wasPlayingBeforeHidden = false;
      activeAudio.muted = false;
      activeAudio.play().then(
        () => fadeVolume(targetVolume),
        () => {
          activeAudio.muted = true;
        },
      );
    });

    syncSoundToggles();
    soundWindow.__soundController = { sync: syncSoundToggles };
    document.addEventListener("click", (event) => {
      const toggle = (event.target as Element).closest<HTMLButtonElement>("[data-sound-toggle]");
      if (!toggle) return;
      if (soundEnabled) disableSound();
      else enableSound();
    });

    const retryOnUserGesture = () => {
      if (soundEnabled && audio.paused) tryPlayback();
    };
    document.addEventListener("click", retryOnUserGesture, { capture: true });
    document.addEventListener("keydown", retryOnUserGesture, { capture: true });
  }
</script>
