---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import FadeSwapText from "@/components/FadeSwapText.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import HeroParallaxImage from "@/components/HeroParallaxImage.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import ThemeSelect from "@/components/ThemeSelect.astro";
---

<section class="hero">
  <div class="hero__switcher">
    <ThemeSelect />
  </div>

  <HeroParallaxImage class="hero__parallax" />

  <div class="hero__content">
    <h1 class="hero__heading">Queen City Mischief &amp; Magic</h1>
    <FadeSwapText lines={["you belong here"]} class="hero__eyebrow" magical />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /*
      Establishes a stacking context so the children's z-indices (0/1/2 below) resolve
      locally rather than competing with unrelated root-level siblings (e.g. the page-level
      Starfield behind everything, at z-index -1) as more sections land on the page.
    */
    isolation: isolate;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 3rem clamp(1.5rem, 5vw, 4rem);
    /*
      Transparent through the top ~60% ("sky") so the fixed page-level Starfield
      (Starfield.tsx, mounted in index.astro, painted behind everything) shows through —
      Starfield fills that same area with a plain --color-surface-bg solid, so the transition
      is seamless whether or not it's actually drawing stars (reduced motion still gets the
      right flat color, just no twinkle). Fades to the opaque --color-surface-parallax-ground
      at the bottom, where the castle silhouette's rock base sits, so the "ground" blends into
      a solid backdrop instead of also revealing the starfield through it — stars read as sky,
      not as showing through solid ground. That ground token is near-black, matching the
      silhouette's true-black fill (every theme is dark mode) — see HeroParallaxImage.astro.
    */
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 60%,
      var(--color-surface-parallax-ground) 100%
    );
    color: var(--color-surface-text);
  }

  .hero__switcher {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 2;
  }

  .hero__parallax {
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /*
    :global — this class is rendered by FadeSwapText.astro's own template, so it only carries
    that component's Astro scope attribute, not this component's. A scoped selector here would
    compile to `.hero__eyebrow[data-astro-cid-<this-component>]` and never match.
  */
  :global(.hero__eyebrow) {
    display: block;
    font-family: var(--font-script);
    /* Theme-aware gold, not --color-surface-primary — see --surface-eyebrow in tokens.css. */
    color: var(--color-surface-eyebrow);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.75rem;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    font-weight: 400;
    margin: 0;
  }
</style>
