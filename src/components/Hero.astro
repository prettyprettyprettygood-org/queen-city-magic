---
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import { ChevronDown } from "@lucide/astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import EventCountdown from "@/components/EventCountdown.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import HandwritingReveal from "@/components/HandwritingReveal.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below; Biome's Astro frontmatter analysis doesn't see markup usage.
import HeroParallaxImage from "@/components/HeroParallaxImage.astro";
---

<section class="hero">
  <HeroParallaxImage class="hero__parallax" />

  <div class="hero__content">
    <h1 class="hero__heading">Queen City Mischief &amp; Magic</h1>
    <p class="hero__dates">September 26&ndash;27, 2026 &middot; Staunton, VA</p>
    <EventCountdown class="hero__countdown" startDelayMs={1200} />
    <HandwritingReveal class="hero__eyebrow" waitForEvent="countdown-complete" startDelayMs={150} />
  </div>

  <button
    type="button"
    class="hero__scroll-cue focus-glow"
    aria-label="Scroll to next section"
    data-hero-scroll-cue
  >
    <ChevronDown aria-hidden="true" focusable="false" size={28} />
  </button>
</section>

<style>
  .hero {
    position: relative;
    /*
      Establishes a stacking context so the children's z-indices (0/1/2 below) resolve
      locally rather than competing with unrelated root-level siblings (e.g. the page-level
      Starfield behind everything, at z-index -1) as more sections land on the page.
    */
    isolation: isolate;
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 3rem clamp(1.5rem, 5vw, 4rem);
    /*
      Transparent through the top ~60% ("sky") so the fixed page-level Starfield
      (Starfield.tsx, mounted in index.astro, painted behind everything) shows through —
      Starfield fills that same area with a plain --color-surface-bg solid, so the transition
      is seamless whether or not it's actually drawing stars (reduced motion still gets the
      right flat color, just no twinkle). Rises to the opaque --color-surface-parallax-ground
      (now aliased to that same --color-surface-bg — see tokens.css) around the castle's rock
      base, then eases back toward transparent over the last stretch before the section's own
      edge. Without that final ease-out, the section boundary itself became a visible seam: a
      flat-opaque hero bottom butting straight up against the next section (transparent,
      revealing the same fixed Starfield) reads as a hard line even when the two colors match,
      because a solid-to-solid cut is still a cut. Fading out lets the Starfield show through
      gradually instead, so the hero "bleeds" into the page rather than ending at a ruler edge.
    */
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 55%,
      var(--color-surface-parallax-ground) 84%,
      transparent 100%
    );
    color: var(--color-surface-text);
  }

  /* Full-width sunset backlight behind the capped castle artwork. */
  .hero::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    background:
      radial-gradient(
        ellipse 24% 20% at 50% 30%,
        color-mix(in srgb, var(--color-magic-glow) 10%, transparent) 0%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 26% 44% at 5% 48%,
        color-mix(in srgb, var(--color-magic-glow) 18%, transparent) 0%,
        transparent 80%
      ),
      radial-gradient(
        ellipse 26% 44% at 95% 48%,
        color-mix(in srgb, var(--color-magic-glow) 18%, transparent) 0%,
        transparent 80%
      );
    pointer-events: none;
  }

  .hero__parallax {
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transform: translateY(clamp(0.75rem, 2vh, 1.5rem));
  }

  /*
    :global — these classes are rendered by EventCountdown.astro/HandwritingReveal.astro's own
    templates, so they only carry those components' Astro scope attributes, not this
    component's. A scoped selector here would compile to `.hero__countdown[data-astro-cid-<this
    component>]` and never match. Sizing/color is each component's own concern — these rules
    are just the layout gaps between stacked hero elements. Tightened from the eyebrow's
    original 3rem now that the countdown sits between the dates and "You belong here," so the
    whole stack still fits the hero's vertical budget.
  */
  :global(.hero__countdown) {
    margin-top: 2rem;
  }

  :global(.hero__eyebrow) {
    margin-top: 2.75rem;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    font-weight: 400;
    margin: 0;
  }

  .hero__dates {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.5vw, 2rem);
    letter-spacing: 0.02em;
    margin: 0.6rem 0 0;
  }

  /*
    Stagger: title, then dates, then the countdown's count-up (EventCountdown's own
    `startDelayMs`, starting once the dates finish fading in), then finally "You belong here"
    (HandwritingReveal's pen-draw) — which doesn't run on a fixed delay at all, it waits for
    EventCountdown's `countdown-complete` event so the handwriting always kicks off right as
    the numbers finish landing, however long that took. Each runs once on load, no repeat
    (plain CSS animations aren't `infinite`, so they hold their `forwards` end state). Scoped
    to motion-safe only, so a reduced-motion visitor sees title and dates plainly visible from
    first paint instead of animated in.
  */
  @media (prefers-reduced-motion: no-preference) {
    .hero__heading,
    .hero__dates {
      opacity: 0;
      transform: translateY(0.75rem);
      animation: hero-stagger-in 650ms ease forwards;
    }

    .hero__dates {
      animation-delay: 550ms;
    }
  }

  @keyframes hero-stagger-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
    Hidden (not just transparent) until JS reveals it once the handwriting draw finishes — see
    the script below. `visibility: hidden` (not opacity/pointer-events alone) so it's also
    pulled out of tab order while invisible; a keyboard user tabbing through before the reveal
    would otherwise land on a control they can't see.
  */
  .hero__scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(12rem, 24vh, 18rem);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    transform: translateX(-50%);
    border: none;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-surface-gold);
    opacity: 0;
    visibility: hidden;
    cursor: pointer;
  }

  .hero__scroll-cue:hover,
  .hero__scroll-cue:focus-visible {
    color: var(--color-surface-gold-active);
  }

  .hero__scroll-cue--visible {
    opacity: 0.85;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-cue {
      transition: opacity 0.6s ease;
    }

    /* Bounce is transform-only (GPU-composited) and skipped entirely under reduced motion — the
       button still appears, just without the continuous loop. */
    .hero__scroll-cue--visible {
      animation: hero-scroll-bounce 1.8s ease-in-out infinite;
    }
  }

  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 0.4rem);
    }
  }
</style>

<script>
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLButtonElement>("[data-hero-scroll-cue]").forEach((button) => {
    const hero = button.closest(".hero");
    // HandwritingReveal.astro dispatches "handwriting-complete" on its own root element (the
    // "You belong here" wrapper) once its pen-draw finishes — waiting for that means the cue
    // fades in only after the rest of the hero's entrance stagger has settled, rather than
    // competing with it for attention.
    const eyebrow = hero?.querySelector<HTMLElement>(".hero__eyebrow");

    const reveal = () => button.classList.add("hero__scroll-cue--visible");

    // Under reduced motion, HandwritingReveal skips its draw animation entirely and never
    // dispatches "handwriting-complete" — reveal immediately instead of waiting forever.
    if (reducedMotionQuery.matches || !eyebrow) {
      reveal();
    } else {
      eyebrow.addEventListener("handwriting-complete", reveal, { once: true });
    }

    button.addEventListener("click", () => {
      hero?.nextElementSibling?.scrollIntoView({
        behavior: reducedMotionQuery.matches ? "auto" : "smooth",
        block: "start",
      });
    });
  });
</script>
